# ---- Cliente ----
# Todo lo que lleve EXPO_PUBLIC_ se empaqueta DENTRO del binario de la app.
# Si algo es secreto, no puede ir aquí: ponerlo equivale a publicarlo.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL de la Edge Function que hace de intermediaria con la base de alimentos.
# La app solo conoce esta URL; la clave de USDA se queda en el servidor.
EXPO_PUBLIC_FOOD_PROXY_URL=https://xxxxxxxx.supabase.co/functions/v1/food

# ---- Solo servidor (Edge Functions y scripts). JAMÁS con prefijo EXPO_PUBLIC_ ----
# SUPABASE_SERVICE_ROLE_KEY=
# USDA_API_KEY=

# Tienda de suplementos naturales enlazada desde el informe semanal de figura.
# Es una URL pública, no un secreto. Sin ella el botón no aparece.
EXPO_PUBLIC_SUPPLEMENTS_URL=

# ---- Solo servidor: escaneo de comida por foto (Edge Function food-scan) ----
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
